# Neon Postgres connection string. Use the "pooled" URL for app traffic.
# Find it at https://console.neon.tech/ → your project → Connection Details.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/dbname?sslmode=require

# Doffin v2 API — Ocp-Apim-Subscription-Key
DOFFIN_API_KEY=YOUR_DOFFIN_OCP_APIM_SUBSCRIPTION_KEY

# Anthropic API key — used to score tenders with Claude Haiku 4.5.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Vercel Cron / pipeline trigger secret. Cron requests must include
# `Authorization: Bearer $CRON_SECRET`. Generate with `openssl rand -hex 32`.
CRON_SECRET=changeme
