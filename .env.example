# Frontend (Vite) — copy to .env.local before `bun dev`
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Edge function secrets — set with `supabase secrets set KEY=value`
# (these are NOT read by the frontend; do not put them in .env.local)
DOFFIN_API_KEY=YOUR_DOFFIN_OCP_APIM_SUBSCRIPTION_KEY
LOVABLE_API_KEY=YOUR_LOVABLE_AI_GATEWAY_KEY
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
